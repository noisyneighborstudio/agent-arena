<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the exact same sim + API sources Unity uses, so the game can run and be tested without the editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Unity 6 compiles C# 9; keep the shared sources honest. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Pez.Headless</RootNamespace>
    <AssemblyName>pez-headless</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../unity/Assets/Pez/Sim/**/*.cs" Link="Sim/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../unity/Assets/Pez/Api/**/*.cs" Link="Api/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
